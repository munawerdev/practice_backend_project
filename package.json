{
  "name": "practice_backend_project",
  "version": "1.0.0",
  "description": "Bun + Express + Mongoose backend practice project",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target=bun --minify",
    "start": "NODE_ENV=production bun run dist/index.js",
    "start:prod": "NODE_ENV=production bun run src/index.ts",
    "lint": "bunx tsc --noEmit",
    "test": "bun test",
    "format": "bunx prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.1",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}