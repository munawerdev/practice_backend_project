{
  "name": "practice_backend_project",
  "version": "1.0.0",
  "description": "Bun + Express + Mongoose backend practice project",
  "module": "src/index.js",
  "main": "src/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.js",
    "build": "bun build src/index.js --outdir dist --target=bun --minify",
    "start": "NODE_ENV=production bun run dist/index.js",
    "start:prod": "NODE_ENV=production bun run src/index.js",
    "lint": "bunx prettier --check .",
    "test": "bun test",
    "format": "bunx prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "mongoose-aggregate-paginate-v2": "^1.1.5",
    "morgan": "^1.12.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
