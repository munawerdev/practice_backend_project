{
  "name": "practice_backend_project",
  "version": "1.0.0",
  "description": "Node.js + Express + Mongoose backend practice project",
  "module": "src/index.js",
  "main": "src/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run src/index.js",
    "build": "bun build src/index.js --outdir dist --target=bun --minify",
    "start": "NODE_ENV=production bun run dist/index.js",
    "start:prod": "NODE_ENV=production bun run src/index.js",
    "lint": "bunx prettier --check .",
    "test": "bun test",
    "format": "bunx prettier --write ."
  },
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/google": "^0.2.12",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.19",
    "mongoose": "^9.11.3",
    "mongoose-aggregate-paginate-v2": "^1.1.5",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
